# Base de datos PostgreSQL
DATABASE_URL="postgresql://escuela:escuela@localhost:5432/escuela?schema=public"

# Clave para firmar las sesiones (cambiar en produccion: openssl rand -base64 48)
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria-min-32-caracteres"

# Duracion de la sesion en horas
SESSION_HORAS="12"

# URL publica del sistema
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (opcional, se activa desde el asistente de instalacion)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
