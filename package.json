{
  "name": "sistema-educacion-configurable",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestion escolar y financiera 100% configurable",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "prueba:humo": "node pruebas/humo.mjs",
    "prueba:asistente": "node pruebas/asistente.mjs",
    "prueba:control": "node pruebas/control-escolar.mjs",
    "prueba:academico": "node pruebas/academico.mjs",
    "prueba:finanzas": "node pruebas/finanzas.mjs",
    "prueba:nomina": "node pruebas/nomina.mjs",
    "prueba:integridad": "node pruebas/integridad-finanzas.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "playwright": "^1.63.0"
  }
}
